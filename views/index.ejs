<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatBox</title>
    <script defer src="/socket.io/socket.io.js"></script>
    <script defer src="/js/client.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@joeattardi/emoji-button@4.6.4/dist/index.min.js"></script>
    <style>
        /* Theme Variables */
        :root {
            --bg-main: #20201d;
            --bg-panel: #2a2f32;
            --bg-navbar: #212529;
            --text-primary: #ffffff;
            --text-secondary: #ece5dd;
            --text-muted: #a6a28c;
            --msg-bg-receive: #2a2f32;
            --msg-bg-send: #005c4b;
            --border-color: #3d4346;
            --input-bg: #2a2f32;
        }

        [data-theme="light"] {
            --bg-main: #efeae2;
            --bg-panel: #f0f2f5;
            --bg-navbar: #008069;
            --text-primary: #111b21;
            --text-secondary: #111b21;
            --text-muted: #667781;
            --msg-bg-receive: #ffffff;
            --msg-bg-send: #d9fdd3;
            --border-color: #d1d7db;
            --input-bg: #ffffff;
        }

        /* Professional Chat Input Styling */
        #send-container {
            display: flex;
            width: 100%;
            margin-bottom: 10px;
            background: var(--input-bg);
            padding: 8px 15px;
            border-radius: 30px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            align-items: center;
            border: 1px solid var(--border-color);
            transition: background 0.3s, border 0.3s;
        }

        #emoji-btn {
            background: none;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            padding: 0 8px 0 0;
            color: var(--text-muted);
            transition: transform 0.2s;
        }
        #emoji-btn:hover {
            transform: scale(1.1);
        }

        #messageInp {
            flex-grow: 1;
            background: transparent;
            border: none;
            color: var(--text-secondary);
            resize: none;
            outline: none;
            padding: 5px;
            font-family: inherit;
            height: 34px;
            max-height: 150px;
            overflow-y: auto;
            line-height: 1.5;
        }

        #messageInp::placeholder {
            color: var(--text-muted);
        }

        .btn-send {
            background-color: #0dcaf0;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            margin-left: 10px;
            box-shadow: 0 2px 5px rgba(13, 202, 240, 0.4);
        }

        .btn-send:hover {
            background-color: #0baccc;
            transform: scale(1.05);
        }

        .btn-send svg {
            fill: white;
            width: 20px;
            height: 20px;
            transform: translateX(2px);
        }

        /* AI Feature Buttons */
        .ai-actions button {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .ai-actions button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(13, 202, 240, 0.2);
            border-color: #0dcaf0;
            color: #0dcaf0;
        }
    </style>
</head>


<body>
    <nav class="navbar py-2 px-3 d-flex align-items-center justify-content-between" style="background-color: var(--bg-navbar); transition: background-color 0.3s; border-bottom: 1px solid var(--border-color); box-shadow: 0 4px 15px rgba(0,0,0,0.1); z-index: 1040; flex-wrap: nowrap;">
        <div class="d-flex align-items-center" style="gap: 12px; overflow: hidden; white-space: nowrap;">
            <!-- Premium App Logo -->
            <div class="avatar shadow d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, #0dcaf0 0%, #005c4b 100%); border: 1.5px solid rgba(255,255,255,0.2);">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>
            </div>
            
            <!-- User Info and Room -->
            <div class="d-flex flex-column justify-content-center" style="overflow: hidden;">
                <div class="d-flex align-items-center" style="gap: 8px;">
                    <h5 class="mb-0 fw-bold text-truncate" style="color: #ffffff; font-family: 'Inter', 'Segoe UI', sans-serif; font-size: 1.05rem; letter-spacing: 0.3px;">
                        Hello, <span id="user" style="color: #0dcaf0;"></span>
                    </h5>
                    <span id="roomId" class="badge rounded-pill bg-success bg-gradient shadow-sm" style="font-size: 0.7rem; font-weight: 600; padding: 0.35em 0.6em; letter-spacing: 0.5px; color: #ffffff;"></span>
                </div>
                <!-- Mini Tip -->
                <small class="text-truncate" style="color: rgba(255, 255, 255, 0.85); font-size: 0.75rem; font-weight: 500;">
                    <span style="color: #ffc107;">✨</span> Try typing <b>@ai</b> to chat with AI!
                </small>
            </div>
        </div>

        <!-- Animated Hamburger Menu -->
        <div class="toggle-sidebar flex-shrink-0" onclick="toggleSidebar()" id="hamburger-icon" style="z-index: 1060;">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                <h3 class="m-0 p-0" style="color: var(--text-primary);">Settings</h3>
            </div>

            <!-- Theme Toggle -->
            <div class="d-flex align-items-center mb-4" style="cursor: pointer;" onclick="toggleTheme()">
                <span style="font-size: 1.2rem; margin-right: 10px;" id="theme-icon">🌙</span>
                <span style="font-weight: bold; color: var(--text-primary);" id="theme-text">Dark Mode</span>
            </div>

            <label class="d-flex align-items-center mb-3" style="cursor: pointer; color: var(--text-primary);">
                <input type="checkbox" id="soundNotification" class="me-2"> Sound Notification
            </label>
            <label class="d-flex align-items-center mb-3" style="cursor: pointer; color: var(--text-primary);">
                <input type="checkbox" id="screenNotification" class="me-2"> Screen Notification
            </label>
            <label class="d-flex align-items-center mb-3" style="cursor: pointer; color: var(--text-primary);">
                <input type="checkbox" id="joinLeaveNotification" class="me-2"> Join/Leave Notification
            </label>
            <hr style="border-color: var(--border-color);">
            <button class="btn btn-success w-100 mt-2 fw-bold shadow-sm" onclick="openGameModal()" style="border-radius: 12px; transition: all 0.2s;">🎮 Play Snake</button>
        </div>
    </nav>
    
    <div class="container-fluid chat-container">
        <div class="chatbox" id="chatbox">
            <!-- Chat messages will appear here -->
        </div>
    </div>
    
    <div class="send-wrapper">
        <div class="send">
            <form action="#" id="send-container">
                <button type="button" id="emoji-btn">😀</button>
                <textarea name="messageInp" id="messageInp" rows="1" placeholder="Type a message..."></textarea>
                <button type="submit" class="btn" id="sendBtn">➤</button>
            </form>
            <div class="ai-actions">
                <button class="btn btn-sm btn-outline-info" onclick="sendAiCommand('joke')">😂 Joke</button>
                <button class="btn btn-sm btn-outline-info" onclick="sendAiCommand('quote')">📜 Quote</button>
                <button class="btn btn-sm btn-outline-info" onclick="sendAiCommand('fact')">🧠 Fact</button>
                <button class="btn btn-sm btn-outline-info" onclick="sendAiCommand('dog')">🐶 Dog</button>
                <button class="btn btn-sm btn-outline-info" onclick="sendAiCommand('trivia')">🎲 Trivia</button>
            </div>
        </div>
    </div>
    
    <!-- Game Modal -->
    <div id="gameModal" class="modal fade" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: #222; color: #fff;">
                <div class="modal-header" style="border-bottom: 1px solid #444;">
                    <h5 class="modal-title">🐍 Endless Snake</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="closeGame()"></button>
                </div>
                <div class="modal-body text-center">
                    <canvas id="gameCanvas" width="400" height="400" style="background-color: #000; border: 2px solid #555; max-width: 100%; box-shadow: 0 0 10px rgba(0,255,0,0.2);"></canvas>
                    <h5 class="mt-3">Score: <span id="gameScore" style="color: lime;">0</span></h5>
                    <button class="btn btn-success mt-2 px-4 py-2" id="startBtn" onclick="startGame()" style="font-weight: bold; font-size: 1.1rem;">Start Game</button>
                </div>
            </div>
        </div>
    </div>    <script>
        let canvas, ctx;
        let snake = [{ x: 10, y: 10 }];
        let food = { x: 15, y: 15 };
        let dx = 1, dy = 0;
        let score = 0;
        let gameLoop;
        const gridSize = 20;
        const tileCount = 20;

        function initGame() {
            canvas = document.getElementById('gameCanvas');
            ctx = canvas.getContext('2d');
            document.addEventListener('keydown', changeDirection);
            drawGame(); // Initial empty draw
        }

        function openGameModal() {
            closex(); // close sidebar
            var myModal = new bootstrap.Modal(document.getElementById('gameModal'));
            myModal.show();
            if (!canvas) initGame();
        }

        function startGame() {
            snake = [{ x: 10, y: 10 }];
            dx = 1; dy = 0;
            score = 0;
            document.getElementById('gameScore').innerText = score;
            placeFood();
            if (gameLoop) clearInterval(gameLoop);
            gameLoop = setInterval(updateGame, 100);
            document.getElementById('startBtn').style.display = 'none';
        }

        function updateGame() {
            const head = { x: snake[0].x + dx, y: snake[0].y + dy };

            // Wrap around
            if (head.x < 0) head.x = tileCount - 1;
            if (head.x >= tileCount) head.x = 0;
            if (head.y < 0) head.y = tileCount - 1;
            if (head.y >= tileCount) head.y = 0;

            // Check collision with self
            for (let i = 0; i < snake.length; i++) {
                if (snake[i].x === head.x && snake[i].y === head.y) {
                    return gameOver();
                }
            }

            snake.unshift(head);

            if (head.x === food.x && head.y === food.y) {
                score += 10;
                document.getElementById('gameScore').innerText = score;
                placeFood();
            } else {
                snake.pop();
            }

            drawGame();
        }

        function drawGame() {
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = 'lime';
            for (let i = 0; i < snake.length; i++) {
                ctx.fillRect(snake[i].x * gridSize, snake[i].y * gridSize, gridSize - 2, gridSize - 2);
            }

            ctx.fillStyle = 'red';
            ctx.fillRect(food.x * gridSize, food.y * gridSize, gridSize - 2, gridSize - 2);
        }

        function placeFood() {
            food = {
                x: Math.floor(Math.random() * tileCount),
                y: Math.floor(Math.random() * tileCount)
            };
            for (let i = 0; i < snake.length; i++) {
                if (snake[i].x === food.x && snake[i].y === food.y) placeFood();
            }
        }

        function changeDirection(event) {
            const LEFT_KEY = 37;
            const RIGHT_KEY = 39;
            const UP_KEY = 38;
            const DOWN_KEY = 40;
            
            const W_KEY = 87;
            const A_KEY = 65;
            const S_KEY = 83;
            const D_KEY = 68;

            const keyPressed = event.keyCode;
            
            // Only capture arrow keys and WASD if modal is open to prevent chat interference
            if (!document.getElementById('gameModal').classList.contains('show')) return;
            
            if([37, 38, 39, 40, 87, 65, 83, 68].includes(keyPressed)) {
                event.preventDefault();
            }

            const goingUp = dy === -1;
            const goingDown = dy === 1;
            const goingRight = dx === 1;
            const goingLeft = dx === -1;

            if ((keyPressed === LEFT_KEY || keyPressed === A_KEY) && !goingRight) { dx = -1; dy = 0; }
            if ((keyPressed === UP_KEY || keyPressed === W_KEY) && !goingDown) { dx = 0; dy = -1; }
            if ((keyPressed === RIGHT_KEY || keyPressed === D_KEY) && !goingLeft) { dx = 1; dy = 0; }
            if ((keyPressed === DOWN_KEY || keyPressed === S_KEY) && !goingUp) { dx = 0; dy = 1; }
        }

        function gameOver() {
            clearInterval(gameLoop);
            ctx.fillStyle = 'white';
            ctx.font = '30px Arial';
            ctx.fillText("Game Over!", 115, 200);
            document.getElementById('startBtn').style.display = 'inline-block';
            document.getElementById('startBtn').innerText = 'Play Again';
        }

        function closeGame() {
            if (gameLoop) clearInterval(gameLoop);
            document.getElementById('startBtn').style.display = 'inline-block';
        }

        function sendAiCommand(cmd) {
            const input = document.getElementById('messageInp');
            input.value = `@ai ${cmd}`;
            const form = document.getElementById('send-container');
            form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
            document.getElementById('hamburger-icon').classList.toggle('open');
        }

        function closex() {
            document.getElementById('sidebar').classList.remove('active');
            document.getElementById('hamburger-icon').classList.remove('open');
        }

        // Theme Initialization and Toggle
        const currentTheme = localStorage.getItem('theme') || 'dark';
        if (currentTheme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            document.getElementById('theme-icon').innerText = '☀️';
            document.getElementById('theme-text').innerText = 'Light Mode';
        }

        function toggleTheme() {
            let theme = 'dark';
            if (document.documentElement.getAttribute('data-theme') === 'dark' || !document.documentElement.hasAttribute('data-theme')) {
                theme = 'light';
            }
            
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);

            if (theme === 'light') {
                document.getElementById('theme-icon').innerText = '☀️';
                document.getElementById('theme-text').innerText = 'Light Mode';
            } else {
                document.getElementById('theme-icon').innerText = '🌙';
                document.getElementById('theme-text').innerText = 'Dark Mode';
            }
        }

        // Event listener for online user invite button
        // document.querySelectorAll('.invite-button').forEach(button => {
        //     button.addEventListener('click', (event) => {
        //         const username = event.target.previousElementSibling.textContent;
        //         alert('Invite sent to ' + username);
        //     });
        // });

        // Event listeners for notification checkboxes
        
        
        // document.getElementById('soundNotification').addEventListener('change', function() {
        //     if (this.checked) {
        //         alert('Sound notifications enabled.');
        //     } else {
        //         alert('Sound notifications disabled.');
        //     }
        // });

        // document.getElementById('screenNotification').addEventListener('change', function() {
        //     if (this.checked) {
        //         alert('Screen notifications enabled.');
        //     } else {
        //         alert('Screen notifications disabled.');
        //     }
        // });

        // document.getElementById('joinLeaveNotification').addEventListener('change', function() {
        //     if (this.checked) {
        //         alert('Join/Leave notifications enabled.');
        //     } else {
        //         alert('Join/Leave notifications disabled.');
        //     }
        // });
   
   </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous">
